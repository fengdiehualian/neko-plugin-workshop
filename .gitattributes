# 打包口径(issue #13/#4):
#
# `git archive`(= 安装包载荷的唯一来源)以前会把 market-corpus 整个打进包里 ——
# 那是 10000+ 条第三方插件源码,里面实测有 GPL 8 个、AGPL 1 个、许可未声明 108 个,
# 而 THIRD_PARTY_NOTICES.md 明写「未声明的不打包分发」。两边说法此前是矛盾的,
# 用 export-ignore 让「不分发」这件事由打包机制保证,不再靠人记着。
#
# 这些目录仍然留在仓库工作区里(单测要靠它们核对真实数量与许可),只是不进导出的包。
market-corpus/** export-ignore
market-corpus export-ignore

# 语料按字节算,不做换行转换(语料锁 corpus.lock.json 的 computedHash 就是这么来的):
# Windows 上 core.autocrlf=true 会把检出改成 CRLF,同一份语料在 Windows 与 ubuntu
# 算出的哈希就对不上,锁会变成"只在一台机器上成立"的东西。
# `-text` 让检出保留 LF,两边读到的字节一致;导出包本来就不含 market-corpus。
market-corpus/** -text
market-corpus -text

# 一次性排查脚本与临时件也不进包(装到用户机器上没用,还泄露本机路径线索)
# 注意:目录本身与目录内容要**两行都写**,只写 `dir/**` 时 git archive 仍会带出该目录下的文件
tools/probes export-ignore
tools/probes/** export-ignore
_tmp_* export-ignore
_tmp_*/** export-ignore

# 发布/打包用的脚本自身不需要出现在安装包里
workbench/build_payload.py export-ignore
workbench/make-exe.ps1 export-ignore
workbench/make-setup-iexpress.py export-ignore
workbench/publish_release.py export-ignore
workbench/check_package.ps1 export-ignore
workbench/check_release_state.py export-ignore
workbench/sync_instance.py export-ignore
workbench/update_sign.cjs export-ignore
workbench/collect_notices.cjs export-ignore
workbench/notes-*.md export-ignore
workbench/cr_*.cjs export-ignore

# 本机配置绝不进包(v1.2.65 实测踩到):wb-studio.config.json 被仓库跟踪,
# 覆盖安装时把用户的端口/引擎口/模型/是否开浏览器全部冲回开发机默认值——
# 隔离实例当场被改写成真实例的 5099/4096 就是证据。
# 工作室读不到该文件时用 defaultConfig 兜底(wb-studio.mjs:config = { ...defaultConfig, ...file }),
# 所以「包里不带」才是正确姿势:首启用默认值,用户改过的设置随升级保留。
wb-studio.config.json export-ignore

# 第三方市场插件副本:references/market-examples/ 下 shell_cmd / tavily_search / sys_monitor
# 与 market-corpus/<slug> 逐字节相同(实测 5/6/5 个文件全等),而三者在许可扫描里都落在「未声明」那一档。
# 既然 market-corpus 因许可问题已经不进包,这三份副本没有理由继续跟着每个安装包分发。
# 坑(issue #4):只写 `dir/**` 时 git archive 照样导出该目录内容,所以两行都要写,且属性文件必须先提交。
packs/neko-plugin/skill/neko-plugin-dev/references/market-examples export-ignore
packs/neko-plugin/skill/neko-plugin-dev/references/market-examples/** export-ignore
# 单测按原始字节核对「这三份是 market-corpus 的逐字节副本」,语料已是 LF;
# 副本若在 Windows 被检出成 CRLF,这条断言就只在 ubuntu 上成立。两处一起钉成 -text。
packs/neko-plugin/skill/neko-plugin-dev/references/market-examples/** -text
packs/neko-plugin/skill/neko-plugin-dev/references/market-examples -text

# 测试与 CI 配置是开发件(issue #18/#30):夹具里还有签名测试钥匙,更不该随包
test export-ignore
test/** export-ignore
.github export-ignore
.github/** export-ignore
.coderabbit.yaml export-ignore
bunfig.toml export-ignore

# tools 根下的页面体检/确认队列探针是纯开发件(issue #18 补充)
tools/approvals-probe.js export-ignore
tools/update-modal-probe.js export-ignore
tools/check-page.mjs export-ignore

# workbench 除「装机版要用的拉取工具」外一律不进包:
#   保留 fetch_corpus.cjs + corpus-lock.cjs(装机版取语料)与 pull_forge/pull_pinned/pull_skill_docs
#   (SKILL/pin 的「按需拉取」入口,装机版没有仓库,没它们就拉不了 deep-dive/forge);
#   release_tls/sfx-installer/pull_*/collect_zcode 是发布机专用,notices.json/zcode_bundle.json 是登记副本
workbench/release_tls.py export-ignore
workbench/sfx-installer.cs export-ignore
workbench/collect_zcode.cjs export-ignore
workbench/notices.json export-ignore
workbench/zcode_bundle.json export-ignore
workbench/workspace export-ignore
workbench/workspace/** export-ignore

# tools/ 整目录都是开发门禁与一次性工具(static_check/syntax_check/tsx_check/
# verify-security/plugin_conformance/render-template…),装机版没有也不需要仓库;
# 文档里引用它们的地方都写了「工坊仓库内」——引用在,文件不随包,口径如实。
tools export-ignore
tools/** export-ignore

# 元数据文件:装到用户机器上没有任何用途(属性文件只对 git archive/checkout 有意义)
.gitattributes export-ignore
.gitignore export-ignore
