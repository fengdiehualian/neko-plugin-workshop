{
  "name": "dsh-plugin-neko",
  "version": "0.1.1",
  "description": "Mirror N.E.K.O. plugin tools into DeepSeek Harness as native dsh tools.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "keywords": [
    "dsh-plugin",
    "neko",
    "bridge"
  ],
  "license": "MIT"
}
