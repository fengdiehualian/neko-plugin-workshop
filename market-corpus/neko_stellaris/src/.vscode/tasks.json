      "type": "shell",
      "command": "uv run neko-plugin check -r \"${workspaceFolder}\"",
      "options": {
        "cwd": "${config:nekoPlugin.repoRoot}"
      },
      "problemMatcher": []
    },
    {
      "label": "N.E.K.O: sync neko_stellaris",
      "type": "shell",
      "command": "uv run neko-plugin sync \"${workspaceFolder}\" --clean",
      "options": {
        "cwd": "${config:nekoPlugin.repoRoot}"
      },
      "problemMatcher": []
    },
    {
      "label": "N.E.K.O: build neko_stellaris",
      "type": "shell",
      "command": "uv run neko-plugin build \"${workspaceFolder}\"",
      "options": {
        "cwd": "${config:nekoPlugin.repoRoot}"
      },
      "problemMatcher": []
    },
    {
      "label": "本仓库: 离线回归套件",
      "detail": "python smoke_offline.py（226 项，不联网、不开游戏）",
