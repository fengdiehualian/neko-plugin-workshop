{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "N.E.K.O: check neko_live_album",
      "type": "shell",
      "command": "uv run neko-plugin check neko_live_album",
      "options": {
        "cwd": "${config:nekoPlugin.repoRoot}"
      },
      "problemMatcher": []
    },
    {
      "label": "N.E.K.O: sync neko_live_album",
      "type": "shell",
      "command": "uv run --with pip neko-plugin sync neko_live_album --clean",
      "options": {
        "cwd": "${config:nekoPlugin.repoRoot}"
      },
      "problemMatcher": []
    },
    {
      "label": "N.E.K.O: check -r neko_live_album",
      "type": "shell",
      "command": "uv run neko-plugin check -r neko_live_album",
      "options": {
        "cwd": "${config:nekoPlugin.repoRoot}"
      },
      "problemMatcher": []
    },
    {
      "label": "N.E.K.O: build neko_live_album",
      "type": "shell",
      "command": "uv run neko-plugin build neko_live_album",
      "options": {
        "cwd": "${config:nekoPlugin.repoRoot}"
      },
      "problemMatcher": []
    }
  ]
}
