{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kards-companion.invalid/schemas/worker-runtime/1",
  "title": "KARDS Companion worker runtime metadata",
  "description": "Optional phase-1 worker-runtime.json contract for the Windows amd64 CPU-only offline bundle. This file is not a second distribution manifest: bundle-manifest.json (schema neko-kards-bundle-manifest/1) is the only distribution manifest and is generated by scripts/bundle_manifest.py. When this optional file is absent, the worker reports bundle manifest component entries only and never claims dependency readiness. Every path is bundle-relative. The build gate must not publish a bundle whose runtime metadata, checksums, or third-party notices are incomplete.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "bundle_id",
    "bundle_version",
    "generated_at",
    "compatibility",
    "runtime",
    "dependencies",
    "models"
  ],
  "properties": {
    "schema": {
      "const": "kards-worker-runtime/1"
    },
    "bundle_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "bundle_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires_python", "platform", "cpu_only"],
      "properties": {
        "requires_python": {
          "const": "3.11",
          "description": "Exact minor version. The bundle must be built and tested with CPython 3.11."
        },
        "platform": {
          "const": "win_amd64",
          "description": "Wheel platform tag. No win32/arm64/linux/macos artifacts."
        },
        "cpu_only": {
          "const": true,
          "description": "CPUExecutionProvider only; no CUDA/DirectML/TensorRT runtime is shipped."
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python_root", "python_exe", "site_packages"],
      "properties": {
        "python_root": {
          "$ref": "#/$defs/relative_path"
        },
        "python_exe": {
          "$ref": "#/$defs/relative_path"
        },
        "site_packages": {
          "$ref": "#/$defs/relative_path"
        }
      }
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "import_names", "required"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "import_names": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
            }
          },
          "required": {
            "type": "boolean"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "dist_info": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "capability": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "required", "sha256", "size_bytes"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "path": {
            "$ref": "#/$defs/relative_path"
          },
          "required": {
            "type": "boolean"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "description": "Verified provenance URL or build record. Do not invent one."
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Only after the build verifies the actual license text; THIRD_PARTY_NOTICES publication gate applies."
          }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size_bytes"],
        "properties": {
          "path": {
            "$ref": "#/$defs/relative_path"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 4096
    }
  },
  "$defs": {
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
      "not": {
        "pattern": "(^|/)\\.\\.?(/|$)"
      },
      "description": "Forward-slash bundle-relative path. No drive, colon, backslash, empty, '.' or '..' segments."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Lowercase SHA-256 of the exact artifact bytes."
    }
  }
}
