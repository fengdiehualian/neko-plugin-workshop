{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "N.E.K.O: check mood_state",
      "type": "shell",
      "command": "uv run neko-plugin check mood_state",
      "options": {
        "cwd": "${config:nekoPlugin.repoRoot}"
      },
      "problemMatcher": []
    },
    {
      "label": "N.E.K.O: sync mood_state",
      "type": "shell",
      "command": "uv run --with pip neko-plugin sync mood_state --clean",
      "options": {
        "cwd": "${config:nekoPlugin.repoRoot}"
      },
      "problemMatcher": []
    },
    {
      "label": "N.E.K.O: check -r mood_state",
      "type": "shell",
      "command": "uv run neko-plugin check -r mood_state",
      "options": {
        "cwd": "${config:nekoPlugin.repoRoot}"
      },
      "problemMatcher": []
    },
    {
      "label": "N.E.K.O: build mood_state",
      "type": "shell",
      "command": "uv run neko-plugin build mood_state",
      "options": {
        "cwd": "${config:nekoPlugin.repoRoot}"
      },
      "problemMatcher": []
    }
  ]
}
